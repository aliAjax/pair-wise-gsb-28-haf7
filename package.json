{
  "name": "hxwlfront-14",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:logic && npm run test:store && npm run test:reload",
    "test:logic": "esbuild test/logic.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/logic-test.mjs && node node_modules/.cache/logic-test.mjs",
    "test:store": "esbuild test/store.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/store-test.mjs && node node_modules/.cache/store-test.mjs",
    "test:reload": "esbuild test/reload.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/reload-test.mjs && node node_modules/.cache/reload-test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "antd": "^5.27.4",
    "echarts": "^5.6.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "zustand": "^5.0.8"
  }
}
